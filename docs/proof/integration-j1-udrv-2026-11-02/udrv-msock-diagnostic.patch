+/// EXPERIMENT: every output line of background process `pid`.
+pub fn bg_output_of(pid: u64) -> alloc::vec::Vec<String> {
+    x86_64::instructions::interrupts::without_interrupts(|| {
+        BG.lock().iter().find(|p| p.pid == pid).map(|p| { let mut v = p.output.clone(); if !p.partial.is_empty() { v.push(p.partial.clone()); } v }).unwrap_or_default()
+    })
