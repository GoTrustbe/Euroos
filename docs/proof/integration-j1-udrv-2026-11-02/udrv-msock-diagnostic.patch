+/// EXPERIMENT (not for merge): /bin/msock as a scheduled background process
+/// over e1000d, to measure where process network syscalls get stuck.
+fn diag_msock(falloc: &mut FrameAllocator) {
+    let t0 = crate::interrupts::ticks();
+    let (tx0, rx0, irq0) = (TX_FRAMES.load(Ordering::Relaxed), RX_FRAMES.load(Ordering::Relaxed), IRQS_DELIVERED.load(Ordering::Relaxed));
+    let before = crate::klock::snapshot_all();
+    without_interrupts(|| {
+        crate::ring3::spawn_bg_musl(falloc, crate::ring3::msock_bytes(), 990, b"/bin/msock");
+        if let Some((task, ..)) = crate::ring3::bg_layout(990) {
+            crate::ring3::set_task_caps(task, crate::ring3::CAP_NET | crate::ring3::CAP_CONSOLE);
+        }
+    });
+    let done = wait_for(6000, falloc, || !crate::ring3::bg_alive(990));
+    crate::serial_println!(
+        "[udrv-msock] (diagnostic) /bin/msock as a scheduled process over e1000d: finished={done} after {} ticks; during the run: netstack tx {} rx {} frames, driver IRQ messages {}",
+        crate::interrupts::ticks() - t0,
+        TX_FRAMES.load(Ordering::Relaxed) - tx0,
+        RX_FRAMES.load(Ordering::Relaxed) - rx0,
+        IRQS_DELIVERED.load(Ordering::Relaxed) - irq0
+    );
+    for l in crate::ring3::bg_output_of(990) {
+        crate::serial_println!("[udrv-msock]   | {l}");
+    }
+    crate::klock::report_delta("udrv-msock", &before, 6);
+    crate::klock::report_hold("udrv-msock", 4);
+}
