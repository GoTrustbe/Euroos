[Unit]
Description=EuroOS live-try websockify (noVNC token proxy for QEMU sessions)
After=network.target

[Service]
Type=simple
User=eurovnc
Group=eurovnc
# Serve the noVNC client and bridge browser websockets to the per-session VNC
# port named by the token file the orchestrator writes.
ExecStart=/usr/bin/websockify --web /usr/share/novnc \
    --token-plugin TokenFile --token-source /run/eurovnc/tokens \
    127.0.0.1:6080
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/run/eurovnc
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
